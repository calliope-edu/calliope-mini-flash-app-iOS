    "gYD-YY-Lxx.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.\"; ObjectID = \"gYD-YY-Lxx\";",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier findest du bereits erstellte Projekte. Die aufgenommenen Daten kannst du dir anschauen, weiterverarbeiten und teilen sowie als Tabelle herunterladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Here you will find your projects. You can view, process, and share the recorded data, as well as download it as a table."
          }
        }
      }
    },
