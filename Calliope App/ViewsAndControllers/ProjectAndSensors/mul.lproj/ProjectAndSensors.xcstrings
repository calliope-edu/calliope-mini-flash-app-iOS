    "M5s-gg-ZTZ.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n2. Erstelle das Programm mit den jeweiligen Daten und definiere benötigte Spalten und setze entsprechende (Sensor-)Daten als Werte.\n\n3. Übertrage das Programm auf deinen Calliope mini.\n\n4. Öffne die Datenlogger Ansicht.\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n2. Create the program with the respective data and define the required columns and set the corresponding (sensor) data as values.\n\n3. Transfer the program to your Calliope mini. \n\n4. Open the data logger view.\n"
          }
        }
      }
    },
