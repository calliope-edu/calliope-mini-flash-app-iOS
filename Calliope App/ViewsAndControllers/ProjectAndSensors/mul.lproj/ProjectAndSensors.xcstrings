    "80R-el-hVU.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es können auf dem Calliope mini 3 Daten aufgezeichnet werden. Daten können mit der Erweiterung Datenlogger in einer Tabelle gespeichert und zusätzlich als Grafik dargestellt werden.\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data can be recorded on the Calliope mini 3. With the datalogger extension data can be saved in a table and also displayed as a graph.\n"
          }
        }
      }
    },
