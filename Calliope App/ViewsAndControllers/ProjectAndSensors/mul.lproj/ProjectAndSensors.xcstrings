    "OaB-k3-pOM.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Wähle die gewünschten Dienste für dein Programm aus, um diese anzusehen oder aufzunehmen.\n4. Starte das Programm auf deinem Calliope mini."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Select the desired services for your program to view or record. \n4. Start the program on your Calliope mini."
