    "2pa-yb-EU6.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Öffne ein Programm in MakeCode über einen QR-Code. Einfach scannen und los geht's!\"; ObjectID = \"2pa-yb-EU6\";",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne ein Programm in MakeCode über einen QR-Code. Einfach scannen und los geht‘s!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open a program in MakeCode using a QR code. Simply scan it and off you go!"
          }
        }
      }
    },
    "5dO-ZD-bhg.text" : {
