    "1pn-RN-v3B.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Übertrage zuerst das Scratch Startprogramm auf deinen Calliope mini, um die Scratch Programme direkt auszuführen.\"; ObjectID = \"1pn-RN-v3B\";",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übertrage zuerst das Scratch Startprogramm auf deinen Calliope mini, um die Scratch Programme direkt auszuführen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First transfer the Scratch Start program to your Calliope mini to run the Scratch programs directly."
          }
        }
      }
    },
