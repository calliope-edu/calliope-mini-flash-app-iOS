    "sDg-74-hMi.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Mit MakeCode Arcade kannst du Spiele für deinen Calliope mini erstellen und diese auf einem Display oder sogar einer Spielekonsole spielen. Die Übertragung funktioniert nur per USB-Kabel.\"; ObjectID = \"sDg-74-hMi\";",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit MakeCode Arcade kannst du Spiele für deinen Calliope mini erstellen und diese auf einem Display anzeigen lassen oder sogar einer Spielekonsole spielen.\nDie Übertragung der Datei funktioniert nur per USB-Kabel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With MakeCode Arcade, you can create games for your Calliope mini and play them with an additional display or even a game console.\nThe files can only be transferred via USB cable."
          }
        }
      }
    },
