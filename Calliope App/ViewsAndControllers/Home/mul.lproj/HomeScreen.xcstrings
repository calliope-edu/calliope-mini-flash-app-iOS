    "mhl-nW-bgq.text" : {
      "comment" : "Class = \"UILabel\"; text = \"- Tasten A+B gedrückt halten\\n- Reset Taste für 1 Sekunde zusätzlich drücken\\n- Tasten A+B gedrückt halten bis die Bluetooth-Animation beendet ist\\n- ID-Muster erscheint auf dem Calliope mini\"; ObjectID = \"mhl-nW-bgq\";",
      "extractionState" : "extracted_with_value",
