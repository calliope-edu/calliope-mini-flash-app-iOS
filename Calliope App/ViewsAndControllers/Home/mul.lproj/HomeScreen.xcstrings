    "EK1-fy-p89.text" : {
      "comment" : "Class = \"UILabel\"; text = \"- Über das rote Calliope mini Icon im Bereich Editoren und Programme öffnet sich das Verbindungsfenster\\n- Individuelles ID-Muster des Calliope mini auf die Matrix übertragen\\n- Wird der Calliope mini gefunden, erscheint eine grüne Schaltfläche\\n- Verbinden bestätigen über das Drücken der grünen Schaltfläche\"; ObjectID = \"EK1-fy-p89\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "- Über das rote Calliope mini Icon im Bereich Editoren und Programme öffnet sich das Verbindungsfenster\n- Individuelles ID-Muster des Calliope mini auf die Matrix übertragen\n- Wird der Calliope mini gefunden, erscheint eine grüne Schaltfläche\n- Verbinden bestätigen über das Drücken der grünen Schaltfläche"
          }
        }
      }
    },
