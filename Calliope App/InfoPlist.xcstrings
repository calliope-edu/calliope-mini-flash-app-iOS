    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth wird benötigt, um sich kabellos mit deinem Calliope mini zu verbinden – damit du Programme übertragen und Daten austauschen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth is used to connect wirelessly to your Calliope mini, so you can flash programs and exchange data."
          }
        }
      }
    },
    "NSBluetoothPeripheralUsageDescription" : {
      "comment" : "Privacy - Bluetooth Peripheral Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth wird benötigt, um sich kabellos mit deinem Calliope mini zu verbinden – damit du Programme übertragen und Daten austauschen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth is used to connect wirelessly to your Calliope mini, so you can flash programs and exchange data."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera wird zum Scannen von QR‑Codes verwendet, mit denen du Programme teilst oder lädst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The camera is used to scan QR codes when sharing or loading programs."
          }
        }
      }
    },
    "NSLocationUsageDescription" : {
      "comment" : "Privacy - Location Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Standort wird verwendet, um Sensormessungen mit dem Ort zu versehen, an dem sie aufgezeichnet wurden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is used to tag sensor readings so you can see where each measurement was recorded."
          }
        }
      }
    },
