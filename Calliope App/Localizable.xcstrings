        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mit MakeCode Arcade kannst du Spiele für deinen Calliope mini erstellen und diese auf einem Display anzeigen lassen oder sogar einer Spielekonsole spielen. Die Übertragung der Datei funktioniert nur per USB-Kabel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
